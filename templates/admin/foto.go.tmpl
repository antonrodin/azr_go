{{ template "app" . }}

{{ define "metadata" }}
<title>Editar foto — admin</title>
<meta name="robots" content="noindex, nofollow" />
{{ end }}

{{ define "content" }}
<main class="page">
    <nav class="admin-bar">
        <span class="monogram">AZR · FOTOLOG</span>
        <span><a href="/admin/fotos">← Fotos</a></span>
    </nav>

    {{ if .Flash }}<p class="flash">{{ .Flash }}</p>{{ end }}

    {{ with .Photo }}
    <div class="photo-edit">
        <div>
            <img class="photo-preview" src="{{ .ImageURL }}" alt="{{ .TitleES }}">

            <p class="aside">
                <span class="badge {{ if eq .Status "public" }}badge-public{{ end }}">{{ if eq .Status "public" }}pública — /fotolog/{{ .Slug }}{{ else }}privada{{ end }}</span>
            </p>

            <table class="exif-table">
                {{ if .TakenAt }}<tr><th>Fecha</th><td>{{ .TakenAt }}</td></tr>{{ end }}
                {{ if .CameraMake }}<tr><th>Cámara</th><td>{{ .CameraMake }} {{ .CameraModel }}</td></tr>{{ end }}
                {{ if .Lens }}<tr><th>Objetivo</th><td>{{ .Lens }}</td></tr>{{ end }}
                {{ if .Focal }}<tr><th>Focal</th><td>{{ .Focal }}</td></tr>{{ end }}
                {{ if .Aperture }}<tr><th>Apertura</th><td>{{ .Aperture }}</td></tr>{{ end }}
                {{ if .Shutter }}<tr><th>Exposición</th><td>{{ .Shutter }}</td></tr>{{ end }}
                {{ if .ISO }}<tr><th>ISO</th><td>{{ .ISO }}</td></tr>{{ end }}
                <tr><th>Tamaño</th><td>{{ .Width }}×{{ .Height }} ({{ .OrigExt }}, {{ .OrigBytes }} bytes)</td></tr>
                {{ if .HasGPS }}<tr><th>GPS</th><td><a href="https://www.openstreetmap.org/?mlat={{ .GPSLat }}&mlon={{ .GPSLng }}#map=16/{{ .GPSLat }}/{{ .GPSLng }}" target="_blank" rel="noopener">{{ printf "%.5f" .GPSLat }}, {{ printf "%.5f" .GPSLng }}</a></td></tr>{{ end }}
            </table>

            <p><a href="{{ .OrigURL }}">Descargar original</a></p>

            <details>
                <summary class="aside">EXIF completo (para muy cafeteros)</summary>
                <pre class="exif-raw">{{ .ExifJSON }}</pre>
            </details>
        </div>

        <div>
            <form method="POST" action="/admin/fotos/{{ .ID }}" class="admin-form">
                <div class="field">
                    <label for="title_es">Título (ES)</label>
                    <input type="text" id="title_es" name="title_es" value="{{ .TitleES }}">
                </div>
                <div class="field">
                    <label for="desc_es">Descripción (ES)</label>
                    <div class="dictate">
                        <button type="button" class="btn btn-mic" id="mic-btn">🎤 Dictar</button>
                        <span class="aside" id="mic-status"></span>
                    </div>
                    <textarea id="desc_es" name="desc_es" rows="4">{{ .DescES }}</textarea>
                </div>
                <div class="field">
                    <label for="title_en">Título (EN)</label>
                    <input type="text" id="title_en" name="title_en" value="{{ .TitleEN }}">
                </div>
                <div class="field">
                    <label for="desc_en">Descripción (EN)</label>
                    <textarea id="desc_en" name="desc_en" rows="4">{{ .DescEN }}</textarea>
                </div>
                <div class="field">
                    <label for="title_ru">Título (RU)</label>
                    <input type="text" id="title_ru" name="title_ru" value="{{ .TitleRU }}">
                </div>
                <div class="field">
                    <label for="desc_ru">Descripción (RU)</label>
                    <textarea id="desc_ru" name="desc_ru" rows="4">{{ .DescRU }}</textarea>
                </div>

                {{ if .HasGPS }}
                <div class="field field-check">
                    <label>
                        <input type="checkbox" name="show_gps" value="1" {{ if .ShowGPS }}checked{{ end }}>
                        Mostrar ubicación en la foto pública <span class="aside">(piénsalo dos veces si es tu casa)</span>
                    </label>
                </div>
                {{ end }}

                <div class="field field-check">
                    <label>
                        <input type="checkbox" name="retranslate" value="1">
                        Retraducir desde el español <span class="aside">(pisa lo que haya en inglés y ruso)</span>
                    </label>
                </div>
                <p class="aside">Al guardar, si dejas inglés o ruso en blanco se rellenan solos desde el español.</p>

                <button type="submit" class="btn">Guardar</button>
            </form>

            <div class="admin-actions">
                {{ if eq .Status "public" }}
                <form method="POST" action="/admin/fotos/{{ .ID }}/despublicar">
                    <button type="submit" class="btn">Despublicar</button>
                </form>
                {{ else }}
                <form method="POST" action="/admin/fotos/{{ .ID }}/publicar">
                    <button type="submit" class="btn">Publicar</button>
                </form>
                {{ end }}

                <form method="POST" action="/admin/fotos/{{ .ID }}/borrar"
                      onsubmit="return confirm('¿Borrar la foto y todos sus ficheros? No hay papelera, no hay drama después.');">
                    <button type="submit" class="btn btn-danger">Borrar</button>
                </form>
            </div>
        </div>
    </div>
    {{ end }}

    <script>
    (function () {
        var btn = document.getElementById('mic-btn');
        var status = document.getElementById('mic-status');
        var area = document.getElementById('desc_es');
        if (!btn || !navigator.mediaDevices || !window.MediaRecorder) {
            if (btn) { btn.disabled = true; btn.title = 'Tu navegador no soporta grabación'; }
            return;
        }

        var recorder = null, chunks = [], recording = false;

        function pickMime() {
            var types = ['audio/webm', 'audio/mp4', 'audio/ogg'];
            for (var i = 0; i < types.length; i++) {
                if (MediaRecorder.isTypeSupported(types[i])) return types[i];
            }
            return '';
        }

        btn.addEventListener('click', async function () {
            if (recording) { recorder.stop(); return; }
            try {
                var stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                var mime = pickMime();
                recorder = mime ? new MediaRecorder(stream, { mimeType: mime }) : new MediaRecorder(stream);
                chunks = [];
                recorder.ondataavailable = function (e) { if (e.data.size) chunks.push(e.data); };
                recorder.onstop = async function () {
                    stream.getTracks().forEach(function (t) { t.stop(); });
                    recording = false;
                    btn.textContent = '🎤 Dictar';
                    btn.classList.remove('recording');
                    var blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
                    status.textContent = 'Transcribiendo…';
                    btn.disabled = true;
                    try {
                        var fd = new FormData();
                        fd.append('audio', blob, 'audio');
                        var resp = await fetch('/admin/transcribir', {
                            method: 'POST', body: fd, headers: { 'Accept': 'application/json' }
                        });
                        var data = await resp.json();
                        if (data.ok) {
                            area.value = area.value.trim() ? (area.value.trim() + '\n\n' + data.text) : data.text;
                            status.textContent = '✔ Listo. Revísalo y guarda.';
                        } else {
                            status.textContent = '✘ ' + (data.error || 'error');
                        }
                    } catch (err) {
                        status.textContent = '✘ error de red: ' + err.message;
                    }
                    btn.disabled = false;
                };
                recorder.start();
                recording = true;
                btn.textContent = '⏹ Parar';
                btn.classList.add('recording');
                status.textContent = 'Grabando… habla y pulsa Parar.';
            } catch (err) {
                status.textContent = '✘ sin acceso al micrófono: ' + err.message;
            }
        });
    })();
    </script>
</main>
{{ end }}
