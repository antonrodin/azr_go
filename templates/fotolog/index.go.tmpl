{{ template "app" . }}

{{ define "metadata" }}
{{ with .T }}
<title>{{ .GalleryTitle }}</title>
<meta name="description" content="{{ .GalleryDesc }}" />
<meta name="robots" content="all" />
{{ end }}

<link rel="canonical" href="{{ .Canonical }}" />
<link rel="alternate" hreflang="es" href="{{ .AltES }}" />
<link rel="alternate" hreflang="en" href="{{ .AltEN }}" />
<link rel="alternate" hreflang="ru" href="{{ .AltRU }}" />
<link rel="alternate" hreflang="x-default" href="{{ .AltES }}" />

<meta property="og:type" content="website" />
<meta property="og:url" content="{{ .Canonical }}" />
<meta property="og:title" content="{{ .T.GalleryTitle }}" />
<meta property="og:description" content="{{ .T.GalleryDesc }}" />
{{ end }}

{{ define "content" }}
<main class="page">
    <nav class="fotolog-top">
        <a href="/" class="monogram">AZR</a>
        <span class="fotolog-actions">
            <a class="btn btn-upload" href="/admin/fotos/subir">Subir foto</a>
            <span class="langs">
                <a href="{{ .LangES }}" {{ if eq .Lang "es" }}class="active" aria-current="true"{{ end }}>ES</a>
                <a href="{{ .LangEN }}" {{ if eq .Lang "en" }}class="active" aria-current="true"{{ end }}>EN</a>
                <a href="{{ .LangRU }}" {{ if eq .Lang "ru" }}class="active" aria-current="true"{{ end }}>RU</a>
            </span>
        </span>
    </nav>

    <h1>{{ .T.GalleryH1 }}</h1>
    <p class="lead-note">{{ .T.GalleryIntro }}</p>

    {{ if not .Photos }}
    <p>{{ .T.Empty }}</p>
    {{ else }}
    <div class="fotolog-grid">
        {{ range .Photos }}
        <a class="fotolog-cell" href="{{ .Href }}">
            <img src="{{ .Src }}" srcset="{{ .SrcSet }}" sizes="(max-width: 720px) 45vw, 240px"
                 alt="{{ .Title }}" loading="lazy"
                 {{ if and .Width .Height }}width="{{ .Width }}" height="{{ .Height }}"{{ end }}>
        </a>
        {{ end }}
    </div>

    {{ if or .PrevURL .NextURL }}
    <nav class="fotolog-pager">
        {{ if .PrevURL }}<a href="{{ .PrevURL }}">{{ .T.Prev }}</a>{{ else }}<span></span>{{ end }}
        {{ if .NextURL }}<a href="{{ .NextURL }}">{{ .T.Next }}</a>{{ else }}<span></span>{{ end }}
    </nav>
    {{ end }}
    {{ end }}
</main>
{{ end }}
