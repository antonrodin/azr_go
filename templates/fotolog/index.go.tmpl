{{ template "app" . }}

{{ define "metadata" }}
{{ with .T }}
<title>{{ .GalleryTitle }}</title>
<meta name="description" content="{{ .GalleryDesc }}" />
{{ end }}
{{ if .NoIndex }}
<meta name="robots" content="noindex, follow" />
{{ else }}
<meta name="robots" content="all" />
{{ end }}

<link rel="canonical" href="{{ .Canonical }}" />
<link rel="alternate" hreflang="es" href="{{ .AltES }}" />
<link rel="alternate" hreflang="en" href="{{ .AltEN }}" />
<link rel="alternate" hreflang="ru" href="{{ .AltRU }}" />
<link rel="alternate" hreflang="x-default" href="{{ .AltES }}" />

<meta property="og:type" content="website" />
<meta property="og:url" content="{{ .Canonical }}" />
<meta property="og:title" content="{{ .T.GalleryTitle }}" />
<meta property="og:description" content="{{ .T.GalleryDesc }}" />
{{ end }}

{{ define "fotolog-controls" }}
<div class="controls">
    <nav class="controls-pager" aria-label="Paginación">
        {{ if .PrevURL }}<a href="{{ .PrevURL }}">{{ .T.Prev }}</a>{{ else }}<span class="disabled">{{ .T.Prev }}</span>{{ end }}
        <span class="controls-pageinfo">{{ .Page }} / {{ .LastPage }}</span>
        {{ if .NextURL }}<a href="{{ .NextURL }}">{{ .T.Next }}</a>{{ else }}<span class="disabled">{{ .T.Next }}</span>{{ end }}
    </nav>
    <form class="controls-search" method="get" action="{{ .SearchAction }}" role="search">
        <input type="search" name="q" value="{{ .Query }}" placeholder="{{ .T.SearchPlaceholder }}" aria-label="{{ .T.SearchPlaceholder }}">
        <button type="submit">{{ .T.SearchButton }}</button>
        {{ if .Searching }}<a class="controls-clear" href="{{ .SearchAction }}">{{ .T.ClearSearch }}</a>{{ end }}
    </form>
    <a class="btn-upload" href="{{ .UploadURL }}">{{ .T.UploadLabel }}</a>
</div>
{{ end }}

{{ define "content" }}
<main class="page">
    <div class="grid">

        <!-- Columna 1: Branding (igual que la portada) -->
        {{ template "components/brand" .Brand }}

        <!-- Columna 2: Fotos -->
        <section class="fotolog-main">
            <h2>{{ .T.GalleryH1 }}</h2>
            <p class="lead-note">{{ .T.GalleryIntro }}</p>

            {{ template "fotolog-controls" . }}

            {{ if not .Photos }}
            <p class="fotolog-empty">{{ if .Searching }}{{ .T.NoResults }}{{ else }}{{ .T.Empty }}{{ end }}</p>
            {{ else }}
            <div class="feed">
                {{ range .Photos }}
                <figure class="feed-item">
                    <a href="{{ .Href }}">
                        <img src="{{ .Src }}" srcset="{{ .SrcSet }}" sizes="(max-width: 720px) 100vw, 600px"
                             alt="{{ .Title }}" loading="lazy"
                             {{ if and .Width .Height }}width="{{ .Width }}" height="{{ .Height }}"{{ end }}>
                    </a>
                    {{ if .Title }}<figcaption><a href="{{ .Href }}">{{ .Title }}</a></figcaption>{{ end }}
                </figure>
                {{ end }}
            </div>

            {{ template "fotolog-controls" . }}
            {{ end }}
        </section>

    </div>
</main>
{{ end }}
